Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Value: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 2
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Value: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Value: true
      Name: Lidar3D
      Topic:
        Value: /lidar/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Use rainbow: true
      Invert Rainbow: false
      Style: Points
      Size (Pixels): 3
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Value: true
      Name: RealSense Color
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/color/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Value: false
      Name: RealSense Infra1 (Left)
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/infra1/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Value: false
      Name: RealSense Infra2 (Right)
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/infra2/image_raw
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Value: false
      Name: RealSense Depth Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/depth/color/points
      Position Transformer: XYZ
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 3
      Use Fixed Frame: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Value: true
      Name: ArUco Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aruco/markers
  Enabled: true
  Global Options:
    Background Color: 28; 32; 38
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Value: Orbit (rviz)
      Distance: 22
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.45
      Yaw: 0.785
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 860
  Width: 1280
  X: 60
  Y: 60
